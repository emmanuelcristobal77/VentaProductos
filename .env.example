# Carpeta donde viven la base de datos y las fotos. En producción: /datos
DATOS_DIR=./datos

# Acceso único de administrador (FR-001).
# El hash se genera con: npx tsx scripts/generar-hash.ts "su-contraseña"
ADMIN_USUARIO=
ADMIN_HASH_CONTRASENA=

# Valores aleatorios de al menos 32 caracteres.
SESION_SECRETO=
IP_SAL=

# Teléfono de contacto publicado, 10 dígitos.
TELEFONO_NEGOCIO=

# Solo para el script de respaldos.
RESPALDO_SUPABASE_URL=
RESPALDO_SUPABASE_LLAVE=
