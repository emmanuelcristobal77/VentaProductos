{
  "name": "vende-productos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:arranque": "esbuild scripts/iniciar.ts scripts/respaldar.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --outdir=arranque --out-extension:.js=.cjs",
    "start": "next start",
    "lint": "eslint .",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generar": "drizzle-kit generate",
    "db:migrar": "tsx --env-file-if-exists=.env.local scripts/migrar.ts",
    "db:semilla": "tsx --env-file-if-exists=.env.local scripts/semilla.ts",
    "verificar": "npm run tipos && npm run lint && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "drizzle-orm": "0.45.4",
    "jose": "^6.2.14",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
