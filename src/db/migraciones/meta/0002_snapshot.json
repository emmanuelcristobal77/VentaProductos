      "checkConstraints": {
        "operaciones_tipo": {
          "name": "operaciones_tipo",
          "value": "tipo IN ('venta', 'apartado', 'encargo')"
        },
        "operaciones_estado": {
          "name": "operaciones_estado",
          "value": "(tipo = 'venta' AND estado IN ('pagada', 'entregada', 'anulada'))\n        OR (tipo <> 'venta' AND estado IN ('pendiente', 'pagado', 'entregado', 'cancelado'))"
        },
        "operaciones_articulo": {
          "name": "operaciones_articulo",
          "value": "(producto_id IS NULL) <> (articulo_encargo_id IS NULL)"
        },
        "operaciones_articulo_solo_encargo": {
          "name": "operaciones_articulo_solo_encargo",
          "value": "articulo_encargo_id IS NULL OR tipo = 'encargo'"
        },
        "operaciones_cantidad": {
          "name": "operaciones_cantidad",
          "value": "cantidad > 0"
        },
        "operaciones_precio": {
          "name": "operaciones_precio",
          "value": "precio_unitario_centavos > 0"
        },
        "operaciones_telefono": {
          "name": "operaciones_telefono",
          "value": "cliente_telefono IS NULL\n        OR (length(cliente_telefono) = 10 AND cliente_telefono NOT GLOB '*[^0-9]*')"
        },
        "operaciones_cliente": {
          "name": "operaciones_cliente",
          "value": "tipo = 'venta' OR datos_borrados_en IS NOT NULL\n        OR (cliente_nombre IS NOT NULL AND cliente_telefono IS NOT NULL)"
        },
        "operaciones_datos_borrados": {
          "name": "operaciones_datos_borrados",
          "value": "datos_borrados_en IS NULL\n        OR (cliente_nombre IS NULL AND cliente_nombre_norm IS NULL AND cliente_telefono IS NULL)"
        },
        "operaciones_aviso": {
          "name": "operaciones_aviso",
          "value": "aviso_informado IS NOT 0 OR (cliente_nombre IS NULL AND cliente_telefono IS NULL)"
        },
        "operaciones_motivo": {
          "name": "operaciones_motivo",
          "value": "estado NOT IN ('anulada', 'cancelado') OR motivo IS NOT NULL"
        }
      }
